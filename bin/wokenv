#!/usr/bin/env bash

# Wokenv - WordPress Development Environment
# https://github.com/wokenv/wokenv
#
# Runs the official @wordpress/env (wp-env) from a container, so that the only
# requirement on the host is Docker. Keep this file compatible with bash 3.2,
# the version shipped with macOS.

set -euo pipefail

readonly DEFAULT_IMAGE="frugan/wokenv:latest"
readonly INSTALL_URL="https://raw.githubusercontent.com/wokenv/wokenv/main/install.sh"

# ---------------------------------------------------------------------------
# Output helpers
# ---------------------------------------------------------------------------

if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
	RED=$'\033[0;31m' GREEN=$'\033[0;32m' YELLOW=$'\033[1;33m' CYAN=$'\033[0;36m' BOLD=$'\033[1m' NC=$'\033[0m'
else
	RED="" GREEN="" YELLOW="" CYAN="" BOLD="" NC=""
fi

info() { printf '%s\n' "$*" >&2; }
success() { printf '%s\n' "${GREEN}✓${NC} $*" >&2; }
warn() { printf '%s\n' "${YELLOW}!${NC} $*" >&2; }
die() {
	printf '%s\n' "${RED}Error:${NC} $*" >&2
	exit 1
}

# ---------------------------------------------------------------------------
# Installation paths
# ---------------------------------------------------------------------------

# Resolves the directory Wokenv is installed in, following the symlink that
# install.sh creates in ~/.local/bin.
resolve_install_dir() {
	local source="${BASH_SOURCE[0]}" dir target
	while [ -L "$source" ]; do
		dir=$(cd -P "$(dirname "$source")" && pwd)
		target=$(readlink "$source")
		case "$target" in
		/*) source="$target" ;;
		*) source="$dir/$target" ;;
		esac
	done
	cd -P "$(dirname "$source")/.." && pwd
}

WOKENV_DIR="${WOKENV_DIR:-$(resolve_install_dir)}"
# Everything Wokenv writes on the host lives here, never in the project.
WOKENV_DATA_DIR="${WOKENV_DATA_DIR:-$WOKENV_DIR/var}"
WOKENV_VERSION=$(tr -d '[:space:]' <"$WOKENV_DIR/VERSION" 2>/dev/null || true)
[ -n "$WOKENV_VERSION" ] || die "VERSION file not found in $WOKENV_DIR. Reinstall with: curl -fsSL $INSTALL_URL | bash"

# ---------------------------------------------------------------------------
# Project
# ---------------------------------------------------------------------------

PROJECT_DIR=""
STATE_DIR=""
WP_ENV_CONFIG=""

# Walks up from the current directory until it finds wokenv.yml.
find_project_dir() {
	local dir
	dir=$(pwd -P)
	while :; do
		if [ -f "$dir/wokenv.yml" ]; then
			printf '%s\n' "$dir"
			return 0
		fi
		[ "$dir" = "/" ] && return 1
		dir=$(dirname "$dir")
	done
}

# Reads a top-level scalar from wokenv.yml. Only used for "image", which must
# be known before any container can run; everything else is parsed in the
# container by lib/wokenv-config.cjs.
read_top_level_scalar() {
	sed -n "s/^$1:[[:space:]]*//p" "$PROJECT_DIR/wokenv.yml" | head -n 1 |
		sed -e 's/[[:space:]]*#.*$//' -e 's/^["'\'']//' -e 's/["'\'']$//' -e 's/[[:space:]]*$//'
}

require_docker() {
	command -v docker >/dev/null 2>&1 || die "Docker is not installed. See https://docs.docker.com/get-docker/"
	docker compose version >/dev/null 2>&1 || die "Docker Compose v2 is required (the 'docker compose' plugin)."
	docker info >/dev/null 2>&1 || die "Cannot reach the Docker daemon. Is Docker running?"
}

load_project() {
	PROJECT_DIR=$(find_project_dir) || die "No wokenv.yml found in this directory or its parents. Run 'wokenv init' first."

	if [ "$(id -u)" = "0" ] && [ -z "${WOKENV_ALLOW_ROOT:-}" ]; then
		die "Do not run wokenv as root: wp-env maps your user into the containers and Apache refuses to run as root."
	fi
	require_docker

	local slug
	slug=$(basename "$PROJECT_DIR" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9]/-/g' -e 's/--*/-/g' -e 's/^-//' -e 's/-$//')
	[ -n "$slug" ] || slug="project"
	# The checksum keeps two projects with the same directory name apart.
	PROJECT_ID="${slug}-$(printf '%s' "$PROJECT_DIR" | cksum | cut -d ' ' -f 1)"
	STATE_DIR="$WOKENV_DATA_DIR/projects/$PROJECT_ID"
	WP_ENV_CONFIG="$STATE_DIR/.wp-env.json"

	local image
	image="${WOKENV_IMAGE:-$(read_top_level_scalar image)}"

	export WOKENV_DIR
	export WOKENV_IMAGE="${image:-$DEFAULT_IMAGE}"
	export WOKENV_PROJECT_DIR="$PROJECT_DIR"
	export WOKENV_STATE_DIR="$STATE_DIR"
	export WOKENV_HOME_DIR="$WOKENV_DATA_DIR/home"
	export WOKENV_CWD
	WOKENV_CWD=$(pwd -P)
	export WOKENV_UID="${WOKENV_UID:-$(id -u)}"
	export WOKENV_GID="${WOKENV_GID:-$(id -g)}"
	export WOKENV_DOCKER_SOCKET="${WOKENV_DOCKER_SOCKET:-/var/run/docker.sock}"

	# Created here so that they belong to the user and not to root, which is
	# what the Docker daemon would do for a missing bind mount source.
	mkdir -p "$STATE_DIR/wp-env" "$WOKENV_HOME_DIR"

	sync_config
}

# Checksum of everything the generated configuration depends on.
config_checksum() {
	{
		printf '%s\n' "$WOKENV_VERSION" "$WOKENV_IMAGE" "$PROJECT_DIR" "$WOKENV_DIR"
		cat "$PROJECT_DIR/wokenv.yml"
		cat "$PROJECT_DIR/.wp-env.json" "$PROJECT_DIR/.wp-env.override.json" 2>/dev/null || true
	} | cksum
}

# Regenerates the wp-env configuration when wokenv.yml changed.
sync_config() {
	local checksum
	checksum=$(config_checksum)
	if [ -f "$WP_ENV_CONFIG" ] && [ -f "$STATE_DIR/project.env" ] && [ -f "$STATE_DIR/compose.override.json" ] &&
		[ "$(cat "$STATE_DIR/checksum" 2>/dev/null || true)" = "$checksum" ]; then
		return 0
	fi

	ensure_image
	docker run --rm \
		--user "$WOKENV_UID:$WOKENV_GID" \
		--network none \
		--entrypoint node \
		--volume "$PROJECT_DIR:$PROJECT_DIR:ro" \
		--volume "$STATE_DIR:$STATE_DIR" \
		--volume "$WOKENV_DIR/lib:$WOKENV_DIR/lib:ro" \
		"$WOKENV_IMAGE" \
		"$WOKENV_DIR/lib/wokenv-config.cjs" \
		--project "$PROJECT_DIR" --state "$STATE_DIR" --lib "$WOKENV_DIR/lib" --home "$HOME" ||
		die "Could not generate the wp-env configuration from wokenv.yml."
	printf '%s\n' "$checksum" >"$STATE_DIR/checksum"
}

# Reads a value written by lib/wokenv-config.cjs. The file is parsed, never
# sourced: it is derived from a wokenv.yml that may come from someone else.
project_value() {
	sed -n "s/^$1=//p" "$STATE_DIR/project.env" | head -n 1
}

ensure_image() {
	docker image inspect "$WOKENV_IMAGE" >/dev/null 2>&1 && return 0
	info "Pulling $WOKENV_IMAGE..."
	docker pull "$WOKENV_IMAGE" >&2 || die "Could not pull $WOKENV_IMAGE."
}

# ---------------------------------------------------------------------------
# Docker plumbing
# ---------------------------------------------------------------------------

compose() {
	docker compose \
		--progress quiet \
		--project-name "wokenv-$PROJECT_ID" \
		--project-directory "$PROJECT_DIR" \
		--file "$WOKENV_DIR/docker-compose.yml" \
		--file "$STATE_DIR/compose.override.json" \
		"$@"
}

# Runs a command in the Wokenv container, as the host user.
toolbox() {
	local tty=()
	# Without a terminal (CI, pipes) docker must not try to allocate one.
	if [ ! -t 0 ] || [ ! -t 1 ]; then
		tty=(--no-TTY)
	fi
	compose run --rm --quiet-pull ${tty[@]+"${tty[@]}"} wokenv "$@"
}

wp_env() {
	toolbox wp-env --config "$WP_ENV_CONFIG" "$@"
}

# Name of the Docker Compose project wp-env created for this project, if any.
wp_env_compose_project() {
	local workdir
	for workdir in "$STATE_DIR"/wp-env/*/; do
		[ -f "${workdir}docker-compose.yml" ] || continue
		docker ps --all \
			--filter "label=com.docker.compose.project.working_dir=${workdir%/}" \
			--format '{{.Label "com.docker.compose.project"}}' | head -n 1
		return 0
	done
}

mailpit_enabled() {
	[ "$(project_value MAILPIT_PORT)" != "0" ]
}

# wp-env owns its Compose project, so Mailpit joins that network from the
# outside, under the "mailpit" name the must-use plugin connects to.
mailpit_connect() {
	mailpit_enabled || return 0
	compose up --detach --quiet-pull mailpit >&2

	local project container
	project=$(wp_env_compose_project)
	container=$(compose ps --quiet mailpit)
	if [ -z "$project" ] || [ -z "$container" ]; then
		warn "Mailpit is running, but the wp-env network was not found: WordPress cannot reach it."
		return 0
	fi
	if ! docker network inspect "${project}_default" --format '{{range .Containers}}{{.Name}} {{end}}' 2>/dev/null |
		grep -q "$(docker inspect --format '{{.Name}}' "$container" | sed 's|^/||')"; then
		docker network connect --alias mailpit "${project}_default" "$container" ||
			warn "Could not connect Mailpit to the wp-env network: WordPress cannot reach it."
	fi
}

# Must run before wp-env removes its network: a network with a container
# still attached cannot be removed.
mailpit_disconnect() {
	local project container
	project=$(wp_env_compose_project)
	container=$(compose ps --all --quiet mailpit 2>/dev/null || true)
	if [ -n "$project" ] && [ -n "$container" ]; then
		docker network disconnect --force "${project}_default" "$container" >/dev/null 2>&1 || true
	fi
}

confirm() {
	local reply
	[ -n "${WOKENV_YES:-}" ] && return 0
	[ -t 0 ] || die "Refusing to continue without confirmation. Pass --yes to skip the prompt."
	printf '%s [y/N] ' "$1" >&2
	read -r reply
	case "$reply" in
	y | Y | yes | YES) return 0 ;;
	*) return 1 ;;
	esac
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_init() {
	local type="" force="" dir
	while [ $# -gt 0 ]; do
		case "$1" in
		--type) type="${2:-}" && shift ;;
		--type=*) type="${1#--type=}" ;;
		--force) force=1 ;;
		*) die "Unknown option for init: $1" ;;
		esac
		shift
	done
	dir=$(pwd -P)

	if [ -f "$dir/wokenv.yml" ] && [ -z "$force" ]; then
		die "wokenv.yml already exists. Use --force to overwrite it."
	fi
	if [ -z "$type" ]; then
		if [ -f "$dir/wp-settings.php" ]; then
			type="core"
		elif grep -qi '^[[:space:]/*#@]*Theme Name:' "$dir/style.css" 2>/dev/null; then
			type="theme"
		elif grep -qil '^[[:space:]/*#@]*Plugin Name:' "$dir"/*.php 2>/dev/null; then
			type="plugin"
		else
			type="none"
			warn "Could not detect a plugin, a theme or WordPress core here: using type 'none'."
		fi
	fi
	case "$type" in
	plugin | theme | core | none) ;;
	*) die "Invalid type '$type'. Use plugin, theme, core or none." ;;
	esac

	{
		cat <<YAML
# yaml-language-server: \$schema=https://raw.githubusercontent.com/wokenv/wokenv/main/schemas/wokenv-schema.json

# Wokenv configuration: the only file your project needs to commit.
# https://github.com/wokenv/wokenv/blob/main/docs/configuration.md

# What this directory contains: plugin, theme, core or none.
type: $type

# Catch every email WordPress sends: true, false or a custom port.
mailpit: true

YAML
		if [ -f "$dir/.wp-env.json" ]; then
			cat <<'YAML'
# This project already has a .wp-env.json: Wokenv uses it as it is.
# Anything set here is applied on top of it.
# wp-env:
#   phpVersion: "8.3"
YAML
		else
			cat <<'YAML'
# Everything below is a standard wp-env configuration, the same keys as
# .wp-env.json: https://developer.wordpress.org/block-editor/reference-guides/packages/packages-env/
wp-env:
  phpVersion: "8.3"
  phpmyadminPort: 9000
  # The second, tests-only WordPress is deprecated in wp-env. Remove this
  # line (and move phpmyadminPort under env.development) if you need it.
  testsEnvironment: false
  # core: WordPress/WordPress#7.1
  # plugins:
  #   - https://downloads.wordpress.org/plugin/query-monitor.zip
  # config:
  #   WP_DEBUG_DISPLAY: true
YAML
		fi
	} >"$dir/wokenv.yml"

	success "Created wokenv.yml (type: $type)"
	info "Next: ${BOLD}wokenv start${NC}"
}

cmd_start() {
	load_project
	wp_env start "$@"
	mailpit_connect
	if mailpit_enabled; then
		info ""
		success "Mailpit started at ${CYAN}http://localhost:$(project_value MAILPIT_PORT)${NC}"
	fi
}

cmd_stop() {
	load_project
	mailpit_disconnect
	wp_env stop "$@"
	compose down --remove-orphans >&2
}

cmd_destroy() {
	local yes=""
	if [ "${1:-}" = "--yes" ] || [ "${1:-}" = "-y" ]; then
		yes=1
		shift
	fi
	load_project
	[ -n "$yes" ] && WOKENV_YES=1
	confirm "This permanently deletes the WordPress environment of '$(basename "$PROJECT_DIR")', database included. Continue?" || {
		info "Cancelled."
		return 0
	}
	mailpit_disconnect
	# Keep going when wp-env has nothing to destroy, e.g. after a failed start.
	wp_env destroy --force "$@" || warn "wp-env could not destroy its environment: cleaning up the rest."
	compose down --volumes --remove-orphans >&2
	rm -rf "$STATE_DIR"
	success "Environment destroyed. Your project files were not touched."
}

cmd_status() {
	load_project
	wp_env status "$@"
	if mailpit_enabled && [ -n "$(compose ps --quiet mailpit 2>/dev/null)" ]; then
		info "Mailpit: http://localhost:$(project_value MAILPIT_PORT)"
	fi
}

# Runs a command in the WordPress CLI container, from the project directory.
run_in_project() {
	local container="$1"
	shift
	wp_env run "$container" --env-cwd="$(project_value ENV_CWD)" -- "$@"
}

cmd_doctor() {
	local failed=0
	info "${BOLD}Wokenv $WOKENV_VERSION${NC} ($WOKENV_DIR)"
	if command -v docker >/dev/null 2>&1; then
		success "docker: $(docker --version)"
	else
		warn "docker: not installed" && failed=1
	fi
	if docker compose version >/dev/null 2>&1; then
		success "docker compose: $(docker compose version --short)"
	else
		warn "docker compose: v2 plugin not found" && failed=1
	fi
	if docker info >/dev/null 2>&1; then
		success "Docker daemon: reachable"
		if docker info --format '{{.SecurityOptions}}' | grep -Eq 'userns|rootless'; then
			warn "Docker runs rootless or with userns-remap: file ownership in the containers will not match your user."
		fi
	else
		warn "Docker daemon: not reachable" && failed=1
	fi
	if [ -S "${WOKENV_DOCKER_SOCKET:-/var/run/docker.sock}" ]; then
		success "Docker socket: ${WOKENV_DOCKER_SOCKET:-/var/run/docker.sock}"
	else
		warn "Docker socket: ${WOKENV_DOCKER_SOCKET:-/var/run/docker.sock} not found (set WOKENV_DOCKER_SOCKET)"
	fi
	if [ "$(id -u)" = "0" ]; then
		warn "Running as root: wp-env needs a regular user."
	fi
	if PROJECT_DIR=$(find_project_dir); then
		success "Project: $PROJECT_DIR"
	else
		info "  Project: no wokenv.yml here (run 'wokenv init')"
	fi
	return "$failed"
}

cmd_self_update() {
	command -v git >/dev/null 2>&1 || die "git is required to update Wokenv."
	[ -d "$WOKENV_DIR/.git" ] || die "$WOKENV_DIR is not a git checkout: reinstall with curl -fsSL $INSTALL_URL | bash"
	git -C "$WOKENV_DIR" pull --ff-only
	docker pull "$DEFAULT_IMAGE" || warn "Could not pull $DEFAULT_IMAGE."
	success "Wokenv $(tr -d '[:space:]' <"$WOKENV_DIR/VERSION")"
}

cmd_help() {
	cat <<HELP
${BOLD}Wokenv $WOKENV_VERSION${NC} - wp-env without Node.js on your machine

${BOLD}Usage:${NC} wokenv <command> [arguments]

${BOLD}Environment${NC}
  ${GREEN}init${NC} [--type <type>]     Create wokenv.yml in the current directory
  ${GREEN}start${NC} [--xdebug] [...]   Start WordPress (same options as 'wp-env start')
  ${GREEN}stop${NC}                     Stop WordPress and free the ports
  ${GREEN}restart${NC}                  Stop, then start
  ${GREEN}status${NC}                   Show URLs and state of the environment
  ${GREEN}logs${NC} [environment]       Show PHP and Docker logs
  ${GREEN}reset${NC} [environment]      Reset the WordPress database
  ${GREEN}destroy${NC} [--yes]          Delete containers, volumes and database

${BOLD}Tools${NC} (run from anywhere inside the project)
  ${GREEN}wp${NC} <args>                WP-CLI, e.g. wokenv wp plugin list
  ${GREEN}composer${NC} <args>          Composer, in the project directory
  ${GREEN}phpunit${NC} [args]           PHPUnit in the tests environment
  ${GREEN}shell${NC} [container]        Bash in a container (default: cli)
  ${GREEN}run${NC} <container> <cmd>    Any command in a wp-env container
  ${GREEN}npm${NC} | ${GREEN}npx${NC} | ${GREEN}node${NC} <args>  Node.js tooling, in the current directory
  ${GREEN}wp-env${NC} <args>            Call wp-env directly

${BOLD}Wokenv${NC}
  ${GREEN}doctor${NC}                   Check that this machine can run Wokenv
  ${GREEN}self-update${NC}              Update Wokenv and its image
  ${GREEN}version${NC}                  Show the Wokenv and wp-env versions
  ${GREEN}help${NC}                     Show this message

Documentation: https://github.com/wokenv/wokenv
HELP
}

main() {
	local command="${1:-help}"
	[ $# -gt 0 ] && shift

	case "$command" in
	init) cmd_init "$@" ;;
	start) cmd_start "$@" ;;
	stop) cmd_stop "$@" ;;
	restart)
		cmd_stop
		cmd_start "$@"
		;;
	destroy) cmd_destroy "$@" ;;
	status | info) cmd_status "$@" ;;
	logs | reset | clean | cleanup | run)
		load_project
		wp_env "$command" "$@"
		;;
	wp-env)
		load_project
		wp_env "$@"
		;;
	wp | cli)
		load_project
		wp_env run cli -- wp "$@"
		;;
	composer)
		load_project
		run_in_project cli composer "$@"
		;;
	phpunit | test)
		load_project
		run_in_project tests-cli phpunit "$@"
		;;
	shell)
		load_project
		wp_env run "${1:-cli}" -- bash
		;;
	npm | npx | node)
		load_project
		toolbox "$command" "$@"
		;;
	doctor) cmd_doctor ;;
	self-update) cmd_self_update ;;
	version | --version | -v)
		printf 'wokenv %s\n' "$WOKENV_VERSION"
		if PROJECT_DIR=$(find_project_dir) && docker info >/dev/null 2>&1; then
			load_project
			printf 'wp-env %s\n' "$(toolbox wp-env --version 2>/dev/null | tr -d '\r')"
		fi
		;;
	help | --help | -h) cmd_help ;;
	*) die "Unknown command '$command'. Run 'wokenv help'." ;;
	esac
}

main "$@"
